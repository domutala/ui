{
  "name": "domutala-ui",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "build": "runable build",
    "prepare": "runable prepare",
    "playground:prepare": "cd playground && runable prepare",
    "playground:build": "cd playground && runable build",
    "playground:dev": "pnpm --filter ./playground dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm test && pnpm typecheck && pnpm build && changeset publish"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.2",
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.46.0",
    "@runablejs/tailwindcss": "^0.1.0",
    "@unovis/vue": "^1.7.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vee-validate": "^4.15.1",
    "vue-input-otp": "^0.4.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@runablejs/cli": "1.2.1",
    "@types/node": "^24.13.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.0",
    "runable": "1.2.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "vue": "^3.5.0",
    "vue-router": "^5.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
